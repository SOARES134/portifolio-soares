        }
        .modal-secondary {width:100%;padding:11px;margin-top:8px;border:1px solid #333;border-radius:9px;background:#171717;color:white;cursor:pointer}
        .account-message {font-size:.83rem;color:#c7c7c7;margin-top:12px;min-height:20px;overflow-wrap:anywhere}
        .profile-editor {display:none;border-top:1px solid #333;margin-top:18px;padding-top:18px}
        .profile-preview {width:82px;height:82px;border-radius:50%;object-fit:cover;background:#222;display:block;margin:8px auto 14px;border:2px solid #555}
        .hidden {display:none!important}

        @media(max-width:900px) {
            header {padding:14px 4%;flex-wrap:wrap}
            nav ul {gap:13px;flex-wrap:wrap}
            nav a {font-size:.7rem}
            .account-area {margin-left:auto}
        }
        @media(max-width:600px) {
