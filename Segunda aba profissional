            <button id="authSwitch" class="modal-secondary" type="button" onclick="switchAuthMode()">Criar uma conta</button>
            <button class="modal-secondary" type="button" onclick="sendPasswordReset()">Esqueci minha senha</button>
        </div>

        <div id="profilePanel" class="hidden">
            <p id="signedInEmail" style="color:#aaa;text-align:center;font-size:.85rem;"></p>
            <img id="profilePreview" class="profile-preview" alt="Sua foto de perfil">
            <div style="text-align:center;font-weight:700;margin-bottom:12px;">Sua foto de perfil</div>
            <label for="avatarFile">Escolher ou alterar foto</label>
            <input id="avatarFile" type="file" accept="image/png,image/jpeg,image/webp">
            <button class="modal-action" type="button" onclick="uploadProfilePhoto()">SALVAR FOTO DE PERFIL</button>
            <p style="font-size:.75rem;color:#888;margin-top:8px;">Imagem JPG, PNG ou WebP. Até 5 MB.</p>
        </div>

        <p id="accountMessage" class="account-message" role="status" aria-live="polite"></p>
    </div>
</div>

<script>
/*
  COLOQUE AQUI OS DADOS DO SEU PROJETO SUPABASE.
  Use Project URL e Publishable key (ou a chave anon legada).
  NUNCA coloque a service_role ou uma chave secreta neste HTML.
*/
const SUPABASE_URL = "COLOQUE_SUA_PROJECT_URL";
const SUPABASE_PUBLIC_KEY = "COLOQUE_SUA_PUBLISHABLE_KEY";

let supabaseClient = null;
let currentAccount = null;
let signupMode = false;

const defaultAvatar = "data:image/svg+xml," + encodeURIComponent(
    '<svg xmlns="http://www.w3.org/2000/svg" width="100" height="100"><rect width="100" height="100" fill="#222"/><circle cx="50" cy="38" r="19" fill="#777"/><path d="M15 100c3-25 17-36 35-36s32 11 35 36" fill="#777"/></svg>'
);

function accountMessage(text) {
    document.getElementById("accountMessage").textContent = text || "";
}

function openAccountModal() {
    document.getElementById("accountModal").classList.add("open");
    accountMessage("");
    if (currentAccount) showProfilePanel();
    else showAuthPanel();
}

function closeAccountModal() {
    document.getElementById("accountModal").classList.remove("open");
}

document.getElementById("accountModal").addEventListener("click", function(event) {
    if (event.target === this) closeAccountModal();
});

function showAuthPanel() {
    document.getElementById("authPanel").classList.remove("hidden");
    document.getElementById("profilePanel").classList.add("hidden");
}

function showProfilePanel() {
    document.getElementById("authPanel").classList.add("hidden");
    document.getElementById("profilePanel").classList.remove("hidden");
    document.getElementById("signedInEmail").textContent = currentAccount?.email || "";
    loadProfilePhoto();
}

function switchAuthMode() {
    signupMode = !signupMode;
    document.getElementById("signupNameField").classList.toggle("hidden", !signupMode);
    document.getElementById("modalTitle").textContent = signupMode ? "CRIAR CONTA" : "MINHA CONTA";
    document.getElementById("authSubmit").textContent = signupMode ? "CRIAR CONTA" : "ENTRAR";
    document.getElementById("authSwitch").textContent = signupMode ? "Já tenho uma conta" : "Criar uma conta";
    document.getElementById("authDescription").textContent = signupMode
        ? "Preencha os dados para criar sua conta."
        : "Entre na sua conta ou crie seu cadastro.";
    document.getElementById("accountPassword").autocomplete = signupMode ? "new-password" : "current-password";
    accountMessage("");
}

async function submitAuth() {
    if (!supabaseClient) return accountMessage("Configure primeiro a URL e a chave pública do Supabase no código.");

    const email = document.getElementById("accountEmail").value.trim();
    const password = document.getElementById("accountPassword").value;

    if (!email || !password) return accountMessage("Preencha e-mail e senha.");
    if (password.length < 8) return accountMessage("A senha precisa ter pelo menos 8 caracteres.");

    const button = document.getElementById("authSubmit");
    button.disabled = true;
    accountMessage("Aguarde...");

    try {
        if (signupMode) {
            const displayName = document.getElementById("signupName").value.trim();
            const { data, error } = await supabaseClient.auth.signUp({
                email,
                password,
                options: { data: { display_name: displayName || "Usuário" } }
            });
            if (error) throw error;

            if (data.session) {
                currentAccount = data.user;
                updateAccountUI();
                showProfilePanel();
                accountMessage("Conta criada com sucesso!");
            } else {
                accountMessage("Cadastro iniciado! Confira seu e-mail para confirmar a conta e depois faça login.");
            }
        } else {
            const { data, error } = await supabaseClient.auth.signInWithPassword({ email, password });
            if (error) throw error;
            currentAccount = data.user;
            updateAccountUI();
            showProfilePanel();
            accountMessage("Login realizado com sucesso!");
        }
    } catch (error) {
        accountMessage(error.message || "Não foi possível concluir. Tente novamente.");
    } finally {
        button.disabled = false;
    }
}

async function sendPasswordReset() {
    if (!supabaseClient) return accountMessage("Configure primeiro o Supabase.");
    const email = document.getElementById("accountEmail").value.trim();
    if (!email) return accountMessage("Digite seu e-mail primeiro.");

    try {
        const { error } = await supabaseClient.auth.resetPasswordForEmail(email, {
            redirectTo: window.location.origin + window.location.pathname
        });
        if (error) throw error;
        accountMessage("Se o e-mail estiver cadastrado, você receberá instruções para redefinir a senha.");
    } catch (error) {
        accountMessage(error.message);
    }
}

function updateAccountUI() {
    const openButton = document.getElementById("accountOpenButton");
    const logoutButton = document.getElementById("accountLogoutButton");
    const avatar = document.getElementById("headerAvatar");
    const name = document.getElementById("headerAccountName");

    if (currentAccount) {
        openButton.innerHTML = '<i class="fa-regular fa-user"></i> Minha conta';
        logoutButton.classList.remove("hidden");
        name.textContent = currentAccount.email || "Minha conta";
        avatar.style.display = "block";
        loadProfilePhoto();
    } else {
        openButton.innerHTML = '<i class="fa-regular fa-user"></i> Entrar / Criar conta';
        logoutButton.classList.add("hidden");
        name.textContent = "";
        avatar.style.display = "none";
        avatar.src = defaultAvatar;
    }
}

async function loadProfilePhoto() {
    if (!currentAccount || !supabaseClient) return;
    const { data, error } = await supabaseClient
        .from("profiles")
        .select("avatar_url")
        .eq("id", currentAccount.id)
        .maybeSingle();

    if (error) {
        accountMessage("Não foi possível carregar o perfil: " + error.message);
        return;
    }

    const photo = data?.avatar_url || defaultAvatar;
    document.getElementById("profilePreview").src = photo;
    document.getElementById("headerAvatar").src = photo;
}

async function uploadProfilePhoto() {
    if (!currentAccount || !supabaseClient) return accountMessage("Entre na sua conta primeiro.");

    const file = document.getElementById("avatarFile").files[0];
    if (!file) return accountMessage("Escolha uma imagem primeiro.");

    const allowedTypes = ["image/jpeg", "image/png", "image/webp"];
    if (!allowedTypes.includes(file.type)) return accountMessage("Use uma imagem JPG, PNG ou WebP.");
    if (file.size > 5 * 1024 * 1024) return accountMessage("A imagem deve ter no máximo 5 MB.");

    accountMessage("Enviando foto...");
    const extension = file.type === "image/png" ? "png" : file.type === "image/webp" ? "webp" : "jpg";
    const path = currentAccount.id + "/avatar-" + Date.now() + "." + extension;

    try {
        const { error: uploadError } = await supabaseClient.storage
            .from("soares-media")
            .upload(path, file, { contentType: file.type, upsert: false });

        if (uploadError) throw uploadError;

        const { data: publicData } = supabaseClient.storage
            .from("soares-media")
            .getPublicUrl(path);

        const { error: updateError } = await supabaseClient
            .from("profiles")
            .update({ avatar_url: publicData.publicUrl })
            .eq("id", currentAccount.id);

        if (updateError) throw updateError;

        document.getElementById("profilePreview").src = publicData.publicUrl;
        document.getElementById("headerAvatar").src = publicData.publicUrl;
        document.getElementById("avatarFile").value = "";
        accountMessage("Foto de perfil atualizada!");
    } catch (error) {
        accountMessage("Erro ao salvar a foto: " + error.message);
    }
}

async function logoutAccount() {
    if (!supabaseClient) return;
    const { error } = await supabaseClient.auth.signOut();
    if (error) {
        accountMessage(error.message);
        return;
    }
    currentAccount = null;
    updateAccountUI();
    closeAccountModal();
}

async function initializeAccount() {
    if (SUPABASE_URL.includes("COLOQUE_") || SUPABASE_PUBLIC_KEY.includes("COLOQUE_")) {
        document.getElementById("accountOpenButton").title = "Configure o Supabase para ativar cadastro e login";
        return;
    }

    try {
        supabaseClient = window.supabase.createClient(SUPABASE_URL, SUPABASE_PUBLIC_KEY);
        const { data, error } = await supabaseClient.auth.getSession();
        if (error) throw error;
        currentAccount = data.session?.user || null;
        updateAccountUI();

        supabaseClient.auth.onAuthStateChange((_event, session) => {
            currentAccount = session?.user || null;
            updateAccountUI();
        });
    } catch (error) {
        console.error("Erro ao iniciar autenticação:", error);
    }
}

initializeAccount();
</script>

