        .logo {font-family:'Syncopate',sans-serif;font-size:1.35rem;letter-spacing:-1px;color:white;white-space:nowrap}
        nav ul {display:flex;gap:25px;list-style:none;align-items:center}
        nav a {text-decoration:none;color:var(--gray);font-size:.8rem;font-weight:700;text-transform:uppercase;letter-spacing:1px;transition:var(--transition)}
