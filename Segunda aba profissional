        #home h1 {font-family:'Syncopate',sans-serif;font-size:clamp(3rem,12vw,8rem);line-height:.9}
        .status-grid {display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:20px;margin-top:40px}
        .status-item {background:var(--bg-card);padding:30px;border:1px solid var(--border);border-radius:12px}
        .status-item h4 {font-size:2rem;margin-bottom:5px}
